# EVConnect — variables de entorno.
# Copiar a .env (`cp .env.example .env`). Para el modo demo local NO hace falta editar nada:
# no se usa ningún servicio externo (ni AWS ni Google).
# Nunca subas tu .env al repositorio.

# --- API ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Orígenes permitidos por CORS (separados por coma). En desarrollo la web usa el proxy de Vite.
CORS_ORIGIN=http://localhost:5173
# Zona horaria de negocio (reservas y franjas de disponibilidad). Argentina usa un único huso (UTC−3).
TZ=America/Argentina/Cordoba

# --- Base de datos (PostgreSQL 16 + PostGIS 3.4, ver docker-compose.yml) ---
DATABASE_URL=postgres://tfg:tfg@localhost:5432/tfg

# --- Autenticación: local | cognito ---
AUTH_MODE=local
# Solo modo local. Este valor es de DEMOSTRACIÓN: la API lo acepta con una advertencia
# y se niega a arrancar con él si NODE_ENV=production. Para otro uso, generá uno propio (≥ 32 caracteres).
JWT_SECRET=demo-local-inseguro-cambiar-antes-de-usar-fuera-de-la-demo
# Solo modo Cognito (ver docs/MANUAL_TASKS.md, sección B)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Rutas: auto | offline | google (auto = google si hay clave, si no offline) ---
ROUTING_PROVIDER=offline
# Solo Google (ver docs/MANUAL_TASKS.md, sección C). Se usa solo en el backend.
GOOGLE_MAPS_API_KEY=

# --- Geocodificación: nominatim | static ---
# nominatim: busca direcciones exactas con el servicio gratuito de OpenStreetMap (sin cuenta; 1 búsqueda por segundo).
# static: lista fija de barrios y ciudades, sin ningún servicio externo.
GEOCODING_PROVIDER=nominatim

# --- Motor de recomendación ---
CANDIDATES_LIMIT=8
SEARCH_RADIUS_KM=20
CORRIDOR_KM=5

# --- Frontend (Vite: quedan fijas en el build) ---
VITE_API_URL=/api/v1
VITE_AUTH_MODE=local
VITE_COGNITO_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# --- Producción / contenedor ---
# Proxies confiables delante de la API (1 detrás del Application Load Balancer; 0 en local).
TRUST_PROXY=0
# WEB_DIST la define la imagen de Docker (carpeta con el build de la web). En desarrollo no se usa.
