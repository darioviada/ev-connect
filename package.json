{
  "name": "ev-connect",
  "version": "0.1.0",
  "private": true,
  "description": "EVConnect — demo del sistema de recomendación de puntos de carga para vehículos eléctricos (TFG)",
  "type": "module",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w api --",
    "db:seed": "npm run db:seed -w api --",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w api\" \"npm run dev -w web\"",
    "test": "npm run test --workspaces",
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "build": "npm run build -w web && npm run build -w api",
    "start": "npm run start -w api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
